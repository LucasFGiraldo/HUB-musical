# Copie para ~/.config/hub-kiosk.env no Dell (deploy/kiosk.sh lê a cada abertura da tela).
# Monitor no HDMI do Dell, que sai da placa NVIDIA (PCI 01:00.0): tudo roda nela, sem copiar imagem da Intel (40 -> 58 fps).
# O número da placa (card0/card1) troca entre um boot e outro, então ela é achada pelo endereço PCI, que é fixo.
# Se o HDMI estiver desconectado (monitor desligado), usa as placas normais e a tela abre no notebook.
nvidia_card=$(readlink -f /dev/dri/by-path/pci-0000:01:00.0-card)
nvidia_render=$(readlink -f /dev/dri/by-path/pci-0000:01:00.0-render)
hdmi=$(ls -d /sys/class/drm/$(basename "$nvidia_card")-HDMI-* 2>/dev/null | head -1)
if [ -n "$hdmi" ] && [ "$(cat "$hdmi/status")" = connected ]; then
  export WLR_DRM_DEVICES="$nvidia_card"
  export HUB_KIOSK_FLAGS="--render-node-override=$nvidia_render"
fi
